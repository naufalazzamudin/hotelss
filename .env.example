# ==============================================================================
# HOTEL IT INVENTORY MANAGEMENT - ENVIRONMENT CONFIGURATION (SUPABASE + VERCEL)
# ==============================================================================
# Salin file ini menjadi .env.local (untuk pengembangan Vite lokal):
#   cp .env.example .env.local
#
# Pada dashboard Vercel, tambahkan variabel ini di menu Settings > Environment Variables
# ==============================================================================

# Supabase Project URL (Dapat dilihat di Supabase Dashboard -> Project Settings -> API)
# Contoh: https://xyzcompanyproject.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (Aman ditaruh di frontend, dilindungi oleh Row Level Security/RLS)
# Contoh: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Kode Rahasia Otoritas untuk mengubah kredensial user (Default: INNRATTAN.BJM)
VITE_SECRET_CODE=INNRATTAN.BJM

# ==============================================================================
# HANYA UNTUK SKRIP MIGRASI DATA LOKAL (scripts/migrate-data.ts)
# JANGAN PERNAH MENARUH SERVICE_ROLE_KEY DI FRONTEND ATAU KODE PUBLIK!
# ==============================================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
